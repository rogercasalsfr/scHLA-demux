    REPORT_DIR, "souporcell_cluster_hla_summary.csv"
)
ASSIGNMENT_CSV = os.path.join(REPORT_DIR, "cluster_to_donor_assignments.csv")
MATCH_SCORE_CSV = os.path.join(REPORT_DIR, "donor_match_scores.csv")

DEMULTIPLEX_DIR = os.path.join(RESULTS_ROOT, "demultiplexed", RUN_ID)
DEMULTIPLEX_MANIFEST = os.path.join(DEMULTIPLEX_DIR, "manifest.tsv")


def donor_sort_key(donor):
    donor = str(donor)
    if donor.isdigit():
        return (0, int(donor))
    return (1, donor)


def get_count_bam(_wildcards=None):
    checkpoints.cellranger_multi.get()

    if not os.path.exists(COUNT_BAM):
        raise FileNotFoundError(f"Cell Ranger BAM not found: {COUNT_BAM}")

    return COUNT_BAM


def get_count_barcodes(_wildcards=None):
    checkpoints.cellranger_multi.get()

    if not os.path.exists(COUNT_BARCODES):
        raise FileNotFoundError(f"Cell Ranger barcodes file not found: {COUNT_BARCODES}")

    return COUNT_BARCODES


def get_clusters_file(_wildcards=None):
    return checkpoints.run_souporcell.get().output.clusters


def get_singlet_donors():
    clusters_path = get_clusters_file()

    if not os.path.exists(clusters_path):
        raise FileNotFoundError(f"Souporcell clusters file not found: {clusters_path}")

    donors = set()

    with open(clusters_path) as handle:
        for line in handle:
            fields = line.rstrip("\n").split("\t")

            if len(fields) < 3 or fields[0] == "barcode":
                continue

            if fields[1] == "singlet":
                donors.add(fields[2])

    donors = sorted(donors, key=donor_sort_key)

    if not donors:
        raise ValueError(f"No singlet donors found in {clusters_path}")

    return donors


def genotype_json_inputs(_wildcards):
    donors = get_singlet_donors()
    return expand(
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.json"),
        donor=donors,
    )


def publish_inputs(_wildcards):
    donors = get_singlet_donors()
    inputs = [
        ASSIGNMENT_CSV,
        GENOTYPE_SUMMARY_CSV,
    ]

    patterns = [
        os.path.join(BARCODE_DIR, "donor{donor}_barcodes.txt"),
        os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam"),
        os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam.bai"),
        os.path.join(EXTRACTED_FASTQ_DIR, "donor{donor}_filtered.extracted.fq.gz"),
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.alignment.p"),
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genes.json"),
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.json"),
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.log"),
    ]

    for pattern in patterns:
        inputs.extend(expand(pattern, donor=donors))

    return inputs


rule all:
    input:
        GENOTYPE_SUMMARY_CSV,
        ASSIGNMENT_CSV,
        MATCH_SCORE_CSV,
        DEMULTIPLEX_MANIFEST


checkpoint cellranger_multi:
    input:
        csv=CELLRANGER_MULTI_CSV
    output:
        done=CELLRANGER_DONE
    threads:
        CELLRANGER_THREADS
    params:
        cellranger=CELLRANGER,
        run_id=RUN_ID,
        run_root=CELLRANGER_ROOT,
        localmem=CELLRANGER_MEM_GB,
        done_dir=os.path.dirname(CELLRANGER_DONE),
        count_bam=COUNT_BAM,
        count_barcodes=COUNT_BARCODES
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.run_root}" "{params.done_dir}"
        rm -f "{output.done}"

        if [ -s "{params.count_bam}" ] && [ -s "{params.count_barcodes}" ]; then
          touch "{output.done}"
          printf '[%s] Reusing existing Cell Ranger outputs: %s\n' "$(date '+%F %T')" "{params.count_bam}"
          exit 0
        fi

        cd "{params.run_root}"

        "{params.cellranger}" multi \
          --id="{params.run_id}" \
          --csv="{input.csv}" \
          --localcores="{threads}" \
          --localmem="{params.localmem}"

        test -s "{params.count_bam}"
        test -s "{params.count_barcodes}"
        touch "{output.done}"
        printf '[%s] Finished cellranger_multi: run_id=%s threads=%s\n' "$(date '+%F %T')" "{params.run_id}" "{threads}"
        """


checkpoint run_souporcell:
    input:
        bam=get_count_bam,
        barcodes=get_count_barcodes,
        fasta=SOUPORCELL_FASTA,
        container=SOUPORCELL_CONTAINER
    output:
        clusters=SOUPORCELL_CLUSTERS
    threads:
        SOUPORCELL_THREADS
    params:
        donors=SOUPORCELL_DONORS,
        outdir=SOUPORCELL_OUTDIR,
        outdir_parent=os.path.dirname(SOUPORCELL_OUTDIR),
        optional_args=SOUPORCELL_OPTIONAL_ARGS
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir_parent}"

        if [ -s "{output.clusters}" ]; then
          printf '[%s] Reusing existing souporcell output: %s\n' "$(date '+%F %T')" "{output.clusters}"
          exit 0
        fi

        if [ -d "{params.outdir}" ]; then
          backup_dir="{params.outdir}.partial.$(date '+%Y%m%d_%H%M%S')"
          mv "{params.outdir}" "$backup_dir"
          printf '[%s] Moved incomplete souporcell output to %s\n' "$(date '+%F %T')" "$backup_dir"
        fi

        apptainer exec "{input.container}" \
          souporcell_pipeline.py \
          -i "{input.bam}" \
          -b "{input.barcodes}" \
          -f "{input.fasta}" \
          -t "{threads}" \
          -o "{params.outdir}" \
          -k "{params.donors}" {params.optional_args}

        test -s "{output.clusters}"
        printf '[%s] Finished run_souporcell: output=%s threads=%s\n' "$(date '+%F %T')" "{output.clusters}" "{threads}"
        """


rule make_donor_barcodes:
    input:
        clusters=get_clusters_file
    output:
        barcode_list=os.path.join(BARCODE_DIR, "donor{donor}_barcodes.txt")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{BARCODE_DIR}"

        awk -F '\t' '$2=="singlet" && $3=="{wildcards.donor}" {{print $1}}' \
          "{input.clusters}" > "{output.barcode_list}"
        printf '[%s] Finished make_donor_barcodes: donor=%s\n' "$(date '+%F %T')" "{wildcards.donor}"
        """


rule filter_donor_bam:
    input:
        bam=get_count_bam,
        whitelist=os.path.join(BARCODE_DIR, "donor{donor}_barcodes.txt")
    output:
        bam=os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam"),
        bai=os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam.bai")
    threads:
        ARCASHLA_FILTER_THREADS
    params:
        subset_bam=SUBSET_BAM,
        samtools=SAMTOOLS_CMD,
        tmpdir=TMP_DIR
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{FILTERED_BAM_DIR}"
        export TMPDIR="{params.tmpdir}"

        "{params.subset_bam}" \
          --bam "{input.bam}" \
          --cell-barcodes "{input.whitelist}" \
          --out-bam "{output.bam}" \
          --cores "{threads}"

        "{params.samtools}" index -@ "{threads}" "{output.bam}"
        printf '[%s] Finished filter_donor_bam: donor=%s threads=%s\n' "$(date '+%F %T')" "{wildcards.donor}" "{threads}"
        """


rule extract_donor_fastq:
    input:
        bam=os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam")
    output:
        fq=os.path.join(EXTRACTED_FASTQ_DIR, "donor{donor}_filtered.extracted.fq.gz"),
        log=os.path.join(EXTRACTED_FASTQ_DIR, "donor{donor}_filtered.extract.log")
    threads:
        ARCASHLA_EXTRACT_THREADS
    params:
        arcas=ARCASHLA_CMD,
        env_bin=ARCASHLA_ENV_BIN,
        outdir=EXTRACTED_FASTQ_DIR,
        temp=ARCAS_TEMP_DIR
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir}" "{params.temp}"
        export PATH="{params.env_bin}:$PATH"

        "{params.arcas}" extract "{input.bam}" \
          --single \
          -o "{params.outdir}" \
          -t "{threads}" \
          -v \
          --temp "{params.temp}"
        printf '[%s] Finished extract_donor_fastq: donor=%s threads=%s\n' "$(date '+%F %T')" "{wildcards.donor}" "{threads}"
        """


rule genotype_donor:
    input:
        fq=os.path.join(EXTRACTED_FASTQ_DIR, "donor{donor}_filtered.extracted.fq.gz")
    output:
        alignment=os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.alignment.p"),
        genes=os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genes.json"),
        genotype=os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.json"),
        log=os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.log")
    threads:
        ARCASHLA_GENOTYPE_THREADS
    params:
        arcas=ARCASHLA_CMD,
        env_bin=ARCASHLA_ENV_BIN,
        genes=HLA_GENES,
        population=HLA_POPULATION,
        outdir=GENOTYPE_DIR,
        temp=ARCAS_TEMP_DIR
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir}" "{params.temp}"
        export PATH="{params.env_bin}:$PATH"

        "{params.arcas}" genotype "{input.fq}" \
          --single \
          -g "{params.genes}" \
          -o "{params.outdir}" \
          -t "{threads}" \
          -p "{params.population}" \
          -v \
          --temp "{params.temp}"
        printf '[%s] Finished genotype_donor: donor=%s threads=%s\n' "$(date '+%F %T')" "{wildcards.donor}" "{threads}"
        """


rule summarize_genotypes:
    input:
        genotype_json_inputs
    output:
        csv=GENOTYPE_SUMMARY_CSV
    params:
        script=GENOTYPE_SUMMARY_SCRIPT,
        input_dir=GENOTYPE_DIR,
        report_dir=REPORT_DIR
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.report_dir}"

        python3 "{params.script}" \
          --input-dir "{params.input_dir}" \
          --output-csv "{output.csv}"
        printf '[%s] Finished summarize_genotypes: output=%s\n' "$(date '+%F %T')" "{output.csv}"
        """


rule build_donor_assignments:
    input:
        summary=GENOTYPE_SUMMARY_CSV
    output:
        assignment=ASSIGNMENT_CSV,
        score=MATCH_SCORE_CSV
    params:
        script=ASSIGNMENT_SCRIPT,
        reference=REFERENCE_HLA_CSV or "",
        genes=MATCHING_GENES,
        two_field_flag=MATCHING_TWO_FIELD_FLAG
    shell:
        r"""
        set -euo pipefail

        reference_arg=()
        if [ -n "{params.reference}" ]; then
          reference_arg+=(--reference-csv "{params.reference}")
        fi

        python3 "{params.script}" \
          --genotype-summary "{input.summary}" \
          --assignment-csv "{output.assignment}" \
          --score-csv "{output.score}" \
          --genes "{params.genes}" \
          {params.two_field_flag} \
          "${{reference_arg[@]}}"
        printf '[%s] Finished build_donor_assignments: output=%s\n' "$(date '+%F %T')" "{output.assignment}"
        """


rule publish_demultiplexed:
    input:
        publish_inputs
    output:
        manifest=DEMULTIPLEX_MANIFEST
    params:
        script=PUBLISH_SCRIPT,
        assignment_csv=ASSIGNMENT_CSV,
        genotype_summary=GENOTYPE_SUMMARY_CSV,
        barcode_dir=BARCODE_DIR,
        bam_dir=FILTERED_BAM_DIR,
        fastq_dir=EXTRACTED_FASTQ_DIR,
        genotype_dir=GENOTYPE_DIR,
        output_dir=DEMULTIPLEX_DIR
    shell:
        r"""
        set -euo pipefail

        python3 "{params.script}" \
          --assignment-csv "{params.assignment_csv}" \
          --genotype-summary "{params.genotype_summary}" \
          --barcode-dir "{params.barcode_dir}" \
          --bam-dir "{params.bam_dir}" \
          --fastq-dir "{params.fastq_dir}" \
          --genotype-dir "{params.genotype_dir}" \
          --output-dir "{params.output_dir}" \
          --manifest "{output.manifest}"
        printf '[%s] Finished publish_demultiplexed: output=%s\n' "$(date '+%F %T')" "{output.manifest}"
        """
