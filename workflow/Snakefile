def donor_sort_key(donor):
    donor = str(donor)
    if donor.isdigit():
        return (0, int(donor))
    return (1, donor)


def cellranger_sample_dir(pool):
    """outs/per_sample_outs/<sample>/ of a finished Cell Ranger multi run."""
    checkpoints.cellranger_multi.get(pool=pool)

    run_dir = CELLRANGER_RUN_DIR.format(pool=pool)
    bams = sorted(
        glob.glob(
            os.path.join(run_dir, "outs", "per_sample_outs", "*", "count", "sample_alignments.bam")
        )
    )
    if len(bams) != 1:
        raise WorkflowError(
            f"Expected exactly one Cell Ranger sample BAM under "
            f"{run_dir}/outs/per_sample_outs/, found {len(bams)}"
        )
    return os.path.dirname(os.path.dirname(bams[0]))


def get_count_bam(wildcards):
    return os.path.join(
        cellranger_sample_dir(wildcards.pool), "count", "sample_alignments.bam"
    )


def get_count_barcodes(wildcards):
    return os.path.join(
        cellranger_sample_dir(wildcards.pool),
        "count",
        "sample_filtered_feature_bc_matrix",
        "barcodes.tsv.gz",
    )


def get_singlet_donors(pool):
    clusters_path = checkpoints.run_souporcell.get(pool=pool).output.clusters

    if not os.path.exists(clusters_path):
        raise FileNotFoundError(f"Souporcell clusters file not found: {clusters_path}")

    donors = set()

    with open(clusters_path) as handle:
        for line in handle:
            fields = line.rstrip("\n").split("\t")

            if len(fields) < 3 or fields[0] == "barcode":
                continue

            if fields[1] == "singlet":
                donors.add(fields[2])

    donors = sorted(donors, key=donor_sort_key)

    if not donors:
        raise ValueError(f"No singlet donors found in {clusters_path}")

    return donors


def genotype_json_inputs(wildcards):
    donors = get_singlet_donors(wildcards.pool)
    return expand(
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.json"),
        pool=wildcards.pool,
        donor=donors,
    )


def tcr_contigs_path(pool):
    return os.path.join(
        cellranger_sample_dir(pool), "vdj_t", "filtered_contig_annotations.csv"
    )


def publish_inputs(wildcards):
    pool = wildcards.pool
    donors = get_singlet_donors(pool)
    inputs = [
        ASSIGNMENT_CSV.format(pool=pool),
        GENOTYPE_SUMMARY_CSV.format(pool=pool),
        SOUPORCELL_CLUSTERS.format(pool=pool),
    ]
    if SAMPLES[pool]["has_tcr"]:
        inputs.append(tcr_contigs_path(pool))

    patterns = [
        os.path.join(BARCODE_DIR, "donor{donor}_barcodes.txt"),
        os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam"),
        os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam.bai"),
        os.path.join(EXTRACTED_FASTQ_DIR, "donor{donor}_filtered.extracted.fq.gz"),
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.alignment.p"),
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genes.json"),
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.json"),
        os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.log"),
    ]
    for pattern in patterns:
        inputs.extend(expand(pattern, pool=pool, donor=donors))

    return inputs


def publish_tcr_arg(wildcards):
    """--tcr-contigs for TCR pools. Shell params must not need the checkpoint (dry runs)."""
    if not SAMPLES[wildcards.pool]["has_tcr"]:
        return ""
    found = glob.glob(
        os.path.join(
            CELLRANGER_RUN_DIR.format(pool=wildcards.pool),
            "outs", "per_sample_outs", "*", "vdj_t", "filtered_contig_annotations.csv",
        )
    )
    path = found[0] if found else "<vdj_t/filtered_contig_annotations.csv after Cell Ranger>"
    return f"--tcr-contigs {shlex.quote(path)}"


def make_multi_csv_args(wildcards):
    sample = SAMPLES[wildcards.pool]
    if sample["multi_csv"]:
        return ""

    args = [
        "--gex-reference", GEX_REFERENCE,
        "--gex-fastqs", sample["gex_fastqs"],
        "--gex-fastq-id", sample["gex_fastq_id"],
    ]
    if sample["tcr_fastqs"]:
        args += [
            "--vdj-reference", VDJ_REFERENCE,
            "--tcr-fastqs", sample["tcr_fastqs"],
            "--tcr-fastq-id", sample["tcr_fastq_id"],
        ]
    if sample["expect_cells"]:
        args += ["--expect-cells", str(sample["expect_cells"])]
    return " ".join(shlex.quote(arg) for arg in args)


rule all:
    input:
        expand(GENOTYPE_SUMMARY_CSV, pool=POOLS),
        expand(ASSIGNMENT_CSV, pool=POOLS),
        expand(MATCH_SCORE_CSV, pool=POOLS),
        expand(DEMULTIPLEX_MANIFEST, pool=POOLS),
        ALL_POOLS_DONORS,
        ALL_POOLS_CELLS,
        QC_REPORT


rule make_multi_csv:
    input:
        lambda wildcards: [SAMPLES[wildcards.pool]["multi_csv"]] if SAMPLES[wildcards.pool]["multi_csv"] else []
    output:
        csv=MULTI_CSV
    params:
        script=MULTI_CSV_SCRIPT,
        user_csv=lambda wildcards: SAMPLES[wildcards.pool]["multi_csv"] or "",
        args=make_multi_csv_args
    shell:
        r"""
        set -euo pipefail

        if [ -n "{params.user_csv}" ]; then
          cp "{params.user_csv}" "{output.csv}"
        else
          "{PYTHON}" "{params.script}" {params.args} --output "{output.csv}"
        fi
        """


checkpoint cellranger_multi:
    input:
        csv=MULTI_CSV
    output:
        done=CELLRANGER_DONE
    threads:
        CELLRANGER_THREADS
    params:
        cellranger=CELLRANGER,
        localmem=CELLRANGER_MEM_GB,
        run_dir=lambda wildcards: CELLRANGER_RUN_DIR.format(pool=wildcards.pool)
    shell:
        r"""
        set -euo pipefail
        pool_dir="$(dirname "{params.run_dir}")"
        mkdir -p "$pool_dir"
        rm -f "{output.done}"

        existing_bam="$(compgen -G "{params.run_dir}/outs/per_sample_outs/*/count/sample_alignments.bam" | head -n 1 || true)"
        if [ -n "$existing_bam" ]; then
          touch "{output.done}"
          printf '[%s] Reusing existing Cell Ranger outputs: %s\n' "$(date '+%F %T')" "$existing_bam"
          exit 0
        fi

        cd "$pool_dir"

        "{params.cellranger}" multi \
          --id="$(basename "{params.run_dir}")" \
          --csv="{input.csv}" \
          --localcores="{threads}" \
          --localmem="{params.localmem}"

        compgen -G "{params.run_dir}/outs/per_sample_outs/*/count/sample_alignments.bam" > /dev/null
        touch "{output.done}"
        printf '[%s] Finished cellranger_multi: pool=%s threads=%s\n' "$(date '+%F %T')" "{wildcards.pool}" "{threads}"
        """


checkpoint run_souporcell:
    input:
        bam=get_count_bam,
        barcodes=get_count_barcodes,
        fasta=SOUPORCELL_FASTA,
        container=SOUPORCELL_CONTAINER
    output:
        clusters=SOUPORCELL_CLUSTERS
    threads:
        SOUPORCELL_THREADS
    params:
        apptainer=APPTAINER,
        donors=lambda wildcards: SAMPLES[wildcards.pool]["n_donors"],
        optional_args=SOUPORCELL_OPTIONAL_ARGS
    shell:
        r"""
        set -euo pipefail
        outdir="$(dirname "{output.clusters}")"

        if [ -s "{output.clusters}" ]; then
          printf '[%s] Reusing existing souporcell output: %s\n' "$(date '+%F %T')" "{output.clusters}"
          exit 0
        fi

        if [ -d "$outdir" ] && [ -n "$(ls -A "$outdir")" ]; then
          backup_dir="$outdir.partial.$(date '+%Y%m%d_%H%M%S')"
          mv "$outdir" "$backup_dir"
          printf '[%s] Moved incomplete souporcell output to %s\n' "$(date '+%F %T')" "$backup_dir"
        fi

        "{params.apptainer}" exec "{input.container}" \
          souporcell_pipeline.py \
          -i "{input.bam}" \
          -b "{input.barcodes}" \
          -f "{input.fasta}" \
          -t "{threads}" \
          -o "$outdir" \
          -k "{params.donors}" {params.optional_args}

        test -s "{output.clusters}"
        printf '[%s] Finished run_souporcell: output=%s threads=%s\n' "$(date '+%F %T')" "{output.clusters}" "{threads}"
        """


rule make_donor_barcodes:
    input:
        clusters=SOUPORCELL_CLUSTERS
    output:
        barcode_list=os.path.join(BARCODE_DIR, "donor{donor}_barcodes.txt")
    shell:
        r"""
        set -euo pipefail

        awk -F '\t' '$2=="singlet" && $3=="{wildcards.donor}" {{print $1}}' \
          "{input.clusters}" > "{output.barcode_list}"
        printf '[%s] Finished make_donor_barcodes: pool=%s donor=%s\n' "$(date '+%F %T')" "{wildcards.pool}" "{wildcards.donor}"
        """


rule filter_donor_bam:
    input:
        bam=get_count_bam,
        whitelist=os.path.join(BARCODE_DIR, "donor{donor}_barcodes.txt")
    output:
        bam=os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam"),
        bai=os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam.bai")
    threads:
        ARCASHLA_FILTER_THREADS
    params:
        subset_bam=SUBSET_BAM,
        samtools=SAMTOOLS_CMD,
        tmpdir=TMP_DIR
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.tmpdir}"
        export TMPDIR="{params.tmpdir}"

        "{params.subset_bam}" \
          --bam "{input.bam}" \
          --cell-barcodes "{input.whitelist}" \
          --out-bam "{output.bam}" \
          --cores "{threads}"

        "{params.samtools}" index -@ "{threads}" "{output.bam}"
        printf '[%s] Finished filter_donor_bam: pool=%s donor=%s threads=%s\n' "$(date '+%F %T')" "{wildcards.pool}" "{wildcards.donor}" "{threads}"
        """


rule extract_donor_fastq:
    input:
        bam=os.path.join(FILTERED_BAM_DIR, "donor{donor}_filtered.bam")
    output:
        fq=os.path.join(EXTRACTED_FASTQ_DIR, "donor{donor}_filtered.extracted.fq.gz"),
        log=os.path.join(EXTRACTED_FASTQ_DIR, "donor{donor}_filtered.extract.log")
    threads:
        ARCASHLA_EXTRACT_THREADS
    params:
        arcas=ARCASHLA_CMD,
        env_bin=ARCASHLA_ENV_BIN,
        temp=lambda wildcards: os.path.join(ARCAS_TEMP_DIR, wildcards.pool)
    shell:
        r"""
        set -euo pipefail
        outdir="$(dirname "{output.fq}")"
        mkdir -p "{params.temp}"
        export PATH="{params.env_bin}:$PATH"

        "{params.arcas}" extract "{input.bam}" \
          --single \
          -o "$outdir" \
          -t "{threads}" \
          -v \
          --temp "{params.temp}"
        printf '[%s] Finished extract_donor_fastq: pool=%s donor=%s threads=%s\n' "$(date '+%F %T')" "{wildcards.pool}" "{wildcards.donor}" "{threads}"
        """


rule genotype_donor:
    input:
        fq=os.path.join(EXTRACTED_FASTQ_DIR, "donor{donor}_filtered.extracted.fq.gz")
    output:
        alignment=os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.alignment.p"),
        genes=os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genes.json"),
        genotype=os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.json"),
        log=os.path.join(GENOTYPE_DIR, "donor{donor}_filtered.genotype.log")
    threads:
        ARCASHLA_GENOTYPE_THREADS
    params:
        arcas=ARCASHLA_CMD,
        env_bin=ARCASHLA_ENV_BIN,
        genes=HLA_GENES,
        population=HLA_POPULATION,
        temp=lambda wildcards: os.path.join(ARCAS_TEMP_DIR, wildcards.pool)
    shell:
        r"""
        set -euo pipefail
        outdir="$(dirname "{output.genotype}")"
        mkdir -p "{params.temp}"
        export PATH="{params.env_bin}:$PATH"

        "{params.arcas}" genotype "{input.fq}" \
          --single \
          -g "{params.genes}" \
          -o "$outdir" \
          -t "{threads}" \
          -p "{params.population}" \
          -v \
          --temp "{params.temp}"
        printf '[%s] Finished genotype_donor: pool=%s donor=%s threads=%s\n' "$(date '+%F %T')" "{wildcards.pool}" "{wildcards.donor}" "{threads}"
        """


rule summarize_genotypes:
    input:
        genotype_json_inputs
    output:
        csv=GENOTYPE_SUMMARY_CSV
    params:
        script=GENOTYPE_SUMMARY_SCRIPT,
        input_dir=lambda wildcards: GENOTYPE_DIR.format(pool=wildcards.pool)
    shell:
        r"""
        set -euo pipefail

        "{PYTHON}" "{params.script}" \
          --input-dir "{params.input_dir}" \
          --output-csv "{output.csv}"
        printf '[%s] Finished summarize_genotypes: output=%s\n' "$(date '+%F %T')" "{output.csv}"
        """


rule build_donor_assignments:
    input:
        summary=GENOTYPE_SUMMARY_CSV,
        reference=lambda wildcards: [SAMPLES[wildcards.pool]["hla_csv"]] if SAMPLES[wildcards.pool]["hla_csv"] else []
    output:
        assignment=ASSIGNMENT_CSV,
        score=MATCH_SCORE_CSV
    params:
        script=ASSIGNMENT_SCRIPT,
        reference=lambda wildcards: SAMPLES[wildcards.pool]["hla_csv"],
        genes=MATCHING_GENES,
        two_field_flag=MATCHING_TWO_FIELD_FLAG
    shell:
        r"""
        set -euo pipefail

        reference_arg=()
        if [ -n "{params.reference}" ]; then
          reference_arg+=(--reference-csv "{params.reference}")
        fi

        "{PYTHON}" "{params.script}" \
          --genotype-summary "{input.summary}" \
          --assignment-csv "{output.assignment}" \
          --score-csv "{output.score}" \
          --genes "{params.genes}" \
          {params.two_field_flag} \
          "${{reference_arg[@]}}"
        printf '[%s] Finished build_donor_assignments: output=%s\n' "$(date '+%F %T')" "{output.assignment}"
        """


rule publish_demultiplexed:
    input:
        publish_inputs
    output:
        manifest=DEMULTIPLEX_MANIFEST,
        cell_table=CELL_TABLE
    params:
        script=PUBLISH_SCRIPT,
        clusters=lambda wildcards: SOUPORCELL_CLUSTERS.format(pool=wildcards.pool),
        assignment=lambda wildcards: ASSIGNMENT_CSV.format(pool=wildcards.pool),
        summary=lambda wildcards: GENOTYPE_SUMMARY_CSV.format(pool=wildcards.pool),
        tcr_arg=publish_tcr_arg,
        barcode_dir=lambda wildcards: BARCODE_DIR.format(pool=wildcards.pool),
        bam_dir=lambda wildcards: FILTERED_BAM_DIR.format(pool=wildcards.pool),
        fastq_dir=lambda wildcards: EXTRACTED_FASTQ_DIR.format(pool=wildcards.pool),
        genotype_dir=lambda wildcards: GENOTYPE_DIR.format(pool=wildcards.pool),
        output_dir=lambda wildcards: DEMULTIPLEX_DIR.format(pool=wildcards.pool)
    shell:
        r"""
        set -euo pipefail

        "{PYTHON}" "{params.script}" \
          --pool "{wildcards.pool}" \
          --clusters "{params.clusters}" \
          --assignment-csv "{params.assignment}" \
          --genotype-summary "{params.summary}" \
          --barcode-dir "{params.barcode_dir}" \
          --bam-dir "{params.bam_dir}" \
          --fastq-dir "{params.fastq_dir}" \
          --genotype-dir "{params.genotype_dir}" \
          --output-dir "{params.output_dir}" \
          --manifest "{output.manifest}" \
          --cell-table "{output.cell_table}" {params.tcr_arg}
        printf '[%s] Finished publish_demultiplexed: output=%s\n' "$(date '+%F %T')" "{output.manifest}"
        """


rule summarize_pools:
    input:
        manifests=expand(DEMULTIPLEX_MANIFEST, pool=POOLS),
        cell_tables=expand(CELL_TABLE, pool=POOLS)
    output:
        donors=ALL_POOLS_DONORS,
        cells=ALL_POOLS_CELLS
    params:
        script=POOLS_SUMMARY_SCRIPT
    shell:
        r"""
        set -euo pipefail

        "{PYTHON}" "{params.script}" \
          --manifests {input.manifests:q} \
          --cell-tables {input.cell_tables:q} \
          --donor-summary "{output.donors}" \
          --cell-summary "{output.cells}"
        """


rule qc_report:
    input:
        manifests=expand(DEMULTIPLEX_MANIFEST, pool=POOLS),
        scores=expand(MATCH_SCORE_CSV, pool=POOLS)
    output:
        html=QC_REPORT
    params:
        script=QC_REPORT_SCRIPT,
        pools=" ".join(shlex.quote(f"{pool}={SAMPLES[pool]['n_donors']}") for pool in POOLS),
        genes=MATCHING_GENES
    shell:
        r"""
        set -euo pipefail

        "{PYTHON}" "{params.script}" \
          --results-dir "{RESULTS_ROOT}" \
          --pools {params.pools} \
          --matching-genes "{params.genes}" \
          --output "{output.html}"
        """
