REPORT_DIR = os.path.join(POOL_DIR, "reports")
GENOTYPE_SUMMARY_CSV = os.path.join(REPORT_DIR, "souporcell_cluster_hla_summary.csv")
READS_HLA_SUMMARY_CSV = os.path.join(REPORT_DIR, "cluster_hla_from_reads.csv")
READ_EVIDENCE_CSV = os.path.join(REPORT_DIR, "hla_read_evidence.csv")
READ_FIT_CSV = os.path.join(REPORT_DIR, "donor_read_fit.csv")
# the cluster HLA types used for matching and published with each patient
CLUSTER_HLA_CSV = READS_HLA_SUMMARY_CSV if MATCHING_BY_READS else GENOTYPE_SUMMARY_CSV
