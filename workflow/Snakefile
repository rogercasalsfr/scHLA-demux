# --------------------------------------------------------------------------
# Sample sheet (config/samples.csv): one row per 10x pool
# --------------------------------------------------------------------------

SAMPLE_COLUMNS = ["pool", "gex_fastqs", "tcr_fastqs", "n_donors", "hla_csv"]
OPTIONAL_SAMPLE_COLUMNS = ["gex_fastq_id", "tcr_fastq_id", "expect_cells", "multi_csv"]
POOL_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
FASTQ_NAME = re.compile(
    r"^(?P<id>.+?)_S\d+(?:_L\d{3})?_(?:R[123]|I[12])_\d{3}\.fastq\.gz$"
)


def detect_fastq_id(folder, given, label, where, problems):
    """Return the Cell Ranger fastq_id (the file name part before _S1_L001_R1_001)."""
    if not os.path.isdir(folder):
        problems.append(f"{where}: {label}s folder not found: {folder}")
        return ""

    ids = sorted({m.group("id") for m in map(FASTQ_NAME.match, os.listdir(folder)) if m})
    if given:
        if given not in ids:
            problems.append(
                f"{where}: no FASTQ files named {given}_S*_R1_*.fastq.gz in {folder}"
            )
        return given
    if not ids:
        problems.append(
            f"{where}: no 10x FASTQ files (like NAME_S1_L001_R1_001.fastq.gz) in {folder}"
        )
        return ""
    if len(ids) > 1:
        problems.append(
            f"{where}: {folder} holds FASTQs of several samples ({', '.join(ids)}); "
            f"add a {label}_id column saying which one to use"
        )
        return ""
    return ids[0]


def load_samples(path):
    if not os.path.isfile(path):
        raise WorkflowError(
            f"Sample sheet not found: {path}\n"
            "Set 'samples' in config/config.yaml (see config/samples.csv)."
        )

    fieldnames, rows = hla_table.read_table_rows(path)
    rows = [{key.lower(): value for key, value in row.items()} for row in rows]
    fieldnames = [name.lower() for name in fieldnames]

    problems, warnings, samples = [], [], {}
    matching_genes = set(MATCHING_GENES.split(","))

    missing = [column for column in ("pool",) if column not in fieldnames]
    if "gex_fastqs" not in fieldnames and "multi_csv" not in fieldnames:
        missing.append("gex_fastqs")
    if missing:
        raise WorkflowError(
            f"{path}: missing column(s) {', '.join(missing)}.\n"
            f"Expected header: {','.join(SAMPLE_COLUMNS)}"
        )
    for name in fieldnames:
        if name not in SAMPLE_COLUMNS + OPTIONAL_SAMPLE_COLUMNS:
            warnings.append(f"{path}: column '{name}' is not used and will be ignored")
    if not rows:
        problems.append(f"{path}: no pools listed")

    for line_number, row in enumerate(rows, start=2):
        pool = row.get("pool", "")
        where = f"samples.csv line {line_number} ({pool or 'no pool name'})"
        if not POOL_NAME.match(pool):
            problems.append(
                f"{where}: the pool name must only use letters, digits, '_', '-' or '.'"
            )
            continue
        if pool in samples:
            problems.append(f"{where}: pool {pool} is listed twice")
            continue

        sample = {
            "pool": pool,
            "multi_csv": resolve_optional_path(row.get("multi_csv")),
            "gex_fastqs": resolve_optional_path(row.get("gex_fastqs")) or "",
            "tcr_fastqs": resolve_optional_path(row.get("tcr_fastqs")) or "",
            "gex_fastq_id": "",
            "tcr_fastq_id": "",
            "expect_cells": DEFAULT_EXPECT_CELLS,
            "hla_csv": resolve_optional_path(row.get("hla_csv")) or "",
            "n_donors": None,
        }

        if sample["multi_csv"]:
            if not os.path.isfile(sample["multi_csv"]):
                problems.append(f"{where}: multi_csv not found: {sample['multi_csv']}")
                sample["has_tcr"] = False
            else:
                with open(sample["multi_csv"]) as handle:
                    sample["has_tcr"] = "vdj-t" in handle.read()
        else:
            if not sample["gex_fastqs"]:
                problems.append(f"{where}: gex_fastqs is empty")
            else:
                sample["gex_fastq_id"] = detect_fastq_id(
                    sample["gex_fastqs"], row.get("gex_fastq_id", ""), "gex_fastq", where, problems
                )
            if sample["tcr_fastqs"]:
                sample["tcr_fastq_id"] = detect_fastq_id(
                    sample["tcr_fastqs"], row.get("tcr_fastq_id", ""), "tcr_fastq", where, problems
                )
            sample["has_tcr"] = bool(sample["tcr_fastqs"])

        if row.get("expect_cells"):
            try:
                sample["expect_cells"] = positive_int(row["expect_cells"], "expect_cells")
            except ValueError:
                problems.append(f"{where}: expect_cells must be a whole number")

        if sample["has_tcr"] and not VDJ_REFERENCE and not sample["multi_csv"]:
            problems.append(
                f"{where}: has TCR FASTQs but cellranger.vdj_reference is empty in config.yaml"
            )

        n_hla_donors = None
        if sample["hla_csv"]:
            try:
                table = hla_table.read_hla_table(sample["hla_csv"])
            except hla_table.HLATableError as error:
                problems.append(f"{where}: problem in the HLA table {error}")
            else:
                n_hla_donors = len(table.donors)
                if not matching_genes & set(table.genes):
                    problems.append(
                        f"{where}: the HLA table has genes {', '.join(table.genes)} "
                        f"but matching uses {MATCHING_GENES} (matching.genes in config.yaml)"
                    )
                for column in table.ignored_columns:
                    warnings.append(
                        f"{where}: HLA table column '{column}' is not an HLA column "
                        "(expected names like A_1, A_2) and is ignored"
                    )

        n_donors = row.get("n_donors", "")
        if n_donors:
            try:
                sample["n_donors"] = int(n_donors)
            except ValueError:
                problems.append(f"{where}: n_donors must be a whole number, got {n_donors!r}")
            else:
                if sample["n_donors"] < 2:
                    problems.append(f"{where}: n_donors must be at least 2")
        elif n_hla_donors:
            sample["n_donors"] = n_hla_donors
        else:
            problems.append(
                f"{where}: n_donors is empty (fill it in, or give an hla_csv and its "
                "number of donors is used)"
            )

        if n_hla_donors and sample["n_donors"] and n_hla_donors < sample["n_donors"]:
            warnings.append(
                f"{where}: n_donors is {sample['n_donors']} but the HLA table lists "
                f"{n_hla_donors} patients; patients missing from the table keep their "
                "souporcell cluster name"
            )
        elif n_hla_donors and sample["n_donors"] and n_hla_donors > sample["n_donors"]:
            print(
                f"[scHLA-demux] {where}: the HLA table lists {n_hla_donors} patients for "
                f"{sample['n_donors']} in this pool (fine for a table shared between pools)",
                file=sys.stderr,
            )

        samples[pool] = sample

    return samples, problems, warnings


def check_tools(samples):
    problems = []
    needed = [
        ("cellranger.executable", CELLRANGER, os.path.isfile),
        ("cellranger.gex_reference", GEX_REFERENCE, os.path.isdir),
        ("souporcell.container", SOUPORCELL_CONTAINER, os.path.isfile),
        ("souporcell.reference_fasta", SOUPORCELL_FASTA, os.path.isfile),
        ("arcashla.env_bin (arcasHLA)", ARCASHLA_CMD, os.path.isfile),
        ("arcashla.env_bin (samtools)", SAMTOOLS_CMD, os.path.isfile),
        ("arcashla.subset_bam", SUBSET_BAM, os.path.isfile),
    ]
    if VDJ_REFERENCE and any(sample["has_tcr"] for sample in samples.values()):
        needed.append(("cellranger.vdj_reference", VDJ_REFERENCE, os.path.isdir))

    for label, path, exists in needed:
        if not exists(path):
            problems.append(f"config.yaml {label}: not found: {path}")
    return problems


SAMPLES, _problems, _warnings = load_samples(SAMPLES_CSV)
_problems += check_tools(SAMPLES)

for _warning in _warnings:
    print(f"[warning] {_warning}", file=sys.stderr)
if _problems:
    raise WorkflowError(
        "Please fix these problems before running scHLA-demux:\n"
        + "\n".join(f"  - {problem}" for problem in _problems)
    )

POOLS = list(SAMPLES)

for _sample in SAMPLES.values():
    print(
        f"[scHLA-demux] pool {_sample['pool']}: "
        f"{'GEX + TCR' if _sample['has_tcr'] else 'GEX only'}, "
        f"{_sample['n_donors']} donors, "
        f"HLA table: {_sample['hla_csv'] or 'none (clusters keep souporcell names)'}",
        file=sys.stderr,
    )


wildcard_constraints:
    pool="|".join(re.escape(pool) for pool in POOLS),
    donor=r"\d+",


