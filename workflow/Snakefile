def cfg(path):
    value = config
    for key in path.split("."):
        if key not in value:
            raise KeyError(f"Missing config entry: {path}")
        value = value[key]
    return value


def cfg_or_default(path, default):
    value = config
    for key in path.split("."):
        if not isinstance(value, dict) or key not in value:
            return default
        value = value[key]
    return value


def positive_int(value, label):
    value = int(value)
    if value < 1:
        raise ValueError(f"{label} must be >= 1, got {value}")
    return value


def optional_positive_int(value, label):
    if value in (None, ""):
        return None
    return positive_int(value, label)


def parse_bool(value, label):
    if isinstance(value, bool):
        return value

    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in {"1", "true", "yes", "y", "on"}:
            return True
        if normalized in {"0", "false", "no", "n", "off"}:
            return False

    raise ValueError(f"{label} must be a boolean, got {value!r}")


def comma_separated(value):
    if isinstance(value, (list, tuple)):
        items = [str(item).strip() for item in value if str(item).strip()]
    else:
        items = [item.strip() for item in str(value).split(",") if item.strip()]
    return ",".join(items)


def donor_phase_threads(total_threads, parallel_jobs):
    parallel_jobs = positive_int(parallel_jobs, "parallel_jobs")
    return max(1, total_threads // parallel_jobs)


def resolve_path(path):
    path = os.path.expanduser(str(path))
    if os.path.isabs(path):
        return path
    return os.path.join(REPO_ROOT, path)


def resolve_optional_path(path):
    if path in (None, ""):
        return None
    return resolve_path(path)


