MATCHING_GENES = comma_separated(cfg_or_default("matching.genes", "A,B,C"))
MATCHING_TWO_FIELD_FLAG = (
    "--two-field-resolution"
    if parse_bool(
        cfg_or_default("matching.two_field_resolution", True),
        "matching.two_field_resolution",
    )
    else "--no-two-field-resolution"
)

BARCODE_DIR = os.path.join(ARCASHLA_ROOT, "barcode_lists")
FILTERED_BAM_DIR = os.path.join(ARCASHLA_ROOT, "donor_bam")
EXTRACTED_FASTQ_DIR = os.path.join(ARCASHLA_ROOT, "extracted_fastq")
GENOTYPE_DIR = os.path.join(ARCASHLA_ROOT, "genotype")

REPORT_DIR = os.path.join(RESULTS_ROOT, "reports", RUN_ID)
