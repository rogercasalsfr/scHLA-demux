# --------------------------------------------------------------------------
# Sample sheet (config/samples.csv): one row per 10x pool
# --------------------------------------------------------------------------

SAMPLE_COLUMNS = ["pool", "gex_fastqs", "tcr_fastqs", "n_donors", "hla_csv"]
OPTIONAL_SAMPLE_COLUMNS = [
    "gex_fastq_id", "tcr_fastq_id", "expect_cells", "multi_csv", "manual_assignments",
]
POOL_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
TENX_FASTQ_NAME = re.compile(
    r"^(?P<id>.+?)_S\d+(?:_L\d{3})?_(?P<read>R[123]|I[12])_\d{3}\.fastq\.gz$"
)
# Any other name, e.g. Pool1_GEX_R1.fastq.gz. These FASTQs are linked under 10x
# names in results/<pool>/fastqs/ before Cell Ranger; the originals are not touched.
PLAIN_FASTQ_NAME = re.compile(
    r"^(?P<id>.+?)[_.](?P<read>R[123]|I[12])\.(?:fastq|fq)\.gz$"
)


def find_fastqs(path, given, library, pool, where, problems):
    """Find one library's FASTQs. Return (Cell Ranger fastqs folder, fastq_id, links).

    path is a folder, one FASTQ file of the library, or a folder plus the file name
    start (/data/Pool1_GEX for /data/Pool1_GEX_R1.fastq.gz). links maps the 10x
    names to create in results/<pool>/fastqs/<library>/ to the original files.
    """
    column = f"{library}_fastqs"
    folder = path
    if not os.path.isdir(folder):
        name = os.path.basename(path)
        match = TENX_FASTQ_NAME.match(name) or PLAIN_FASTQ_NAME.match(name)
        given = given or (match.group("id") if match else name)
        folder = os.path.dirname(path)
        if not os.path.isdir(folder):
            problems.append(f"{where}: {column} not found: {path}")
            return "", "", {}

    files = sorted(os.listdir(folder))
    tenx_ids = {m.group("id") for m in map(TENX_FASTQ_NAME.match, files) if m}
    plain = {}
    for match in filter(None, map(PLAIN_FASTQ_NAME.match, files)):
        plain.setdefault(match.group("id"), {})[match.group("read")] = os.path.join(
            folder, match.string
        )
    ids = sorted(tenx_ids | set(plain))

    if given:
        if given not in ids:
            problems.append(
                f"{where}: no FASTQ files named {given}_R1.fastq.gz or "
                f"{given}_S1_L001_R1_001.fastq.gz in {folder}"
            )
            return "", "", {}
        fastq_id = given
    elif not ids:
        problems.append(
            f"{where}: no FASTQ files (like NAME_R1.fastq.gz or "
            f"NAME_S1_L001_R1_001.fastq.gz) in {folder}"
        )
        return "", "", {}
    elif len(ids) > 1:
        problems.append(
            f"{where}: {folder} holds FASTQs of several samples ({', '.join(ids)}); "
            f"add a {library}_fastq_id column saying which one to use, or put "
            f"{folder}/<name> in {column}"
        )
        return "", "", {}
    else:
        fastq_id = ids[0]

    if fastq_id in tenx_ids:
        return folder, fastq_id, {}

    reads = plain[fastq_id]
    for read in ("R1", "R2"):
        if read not in reads:
            problems.append(f"{where}: {fastq_id}_{read}.fastq.gz is missing in {folder}")
            return "", "", {}
    link_dir = os.path.join(RESULTS_ROOT, pool, "fastqs", library)
    links = {
        os.path.join(link_dir, f"{fastq_id}_S1_L001_{read}_001.fastq.gz"): source
        for read, source in reads.items()
    }
    return link_dir, fastq_id, links


def load_samples(path):
    if not os.path.isfile(path):
        raise WorkflowError(
            f"Sample sheet not found: {path}\n"
            "Set 'samples' in config/config.yaml (see config/samples.csv)."
        )

    fieldnames, rows = hla_table.read_table_rows(path)
    rows = [{key.lower(): value for key, value in row.items()} for row in rows]
    fieldnames = [name.lower() for name in fieldnames]

    problems, warnings, samples = [], [], {}
    matching_genes = set(MATCHING_GENES.split(","))

    missing = [column for column in ("pool",) if column not in fieldnames]
    if "gex_fastqs" not in fieldnames and "multi_csv" not in fieldnames:
        missing.append("gex_fastqs")
    if missing:
        raise WorkflowError(
            f"{path}: missing column(s) {', '.join(missing)}.\n"
            f"Expected header: {','.join(SAMPLE_COLUMNS)}"
        )
    for name in fieldnames:
        if name not in SAMPLE_COLUMNS + OPTIONAL_SAMPLE_COLUMNS:
            warnings.append(f"{path}: column '{name}' is not used and will be ignored")
    if not rows:
        problems.append(f"{path}: no pools listed")

    for line_number, row in enumerate(rows, start=2):
        pool = row.get("pool", "")
        where = f"samples.csv line {line_number} ({pool or 'no pool name'})"
        if not POOL_NAME.match(pool):
            problems.append(
                f"{where}: the pool name must only use letters, digits, '_', '-' or '.'"
            )
            continue
        if pool in samples:
            problems.append(f"{where}: pool {pool} is listed twice")
            continue

        sample = {
            "pool": pool,
            "multi_csv": resolve_optional_path(row.get("multi_csv")),
            "gex_fastqs": resolve_optional_path(row.get("gex_fastqs")) or "",
            "tcr_fastqs": resolve_optional_path(row.get("tcr_fastqs")) or "",
            "gex_fastq_id": "",
            "tcr_fastq_id": "",
            "expect_cells": DEFAULT_EXPECT_CELLS,
            "hla_csv": resolve_optional_path(row.get("hla_csv")) or "",
            "manual_assignments": resolve_optional_path(row.get("manual_assignments")) or "",
            "n_donors": None,
            "fastq_links": {},
        }

        if sample["multi_csv"]:
            if not os.path.isfile(sample["multi_csv"]):
                problems.append(f"{where}: multi_csv not found: {sample['multi_csv']}")
                sample["has_tcr"] = False
            else:
                with open(sample["multi_csv"]) as handle:
                    sample["has_tcr"] = "vdj-t" in handle.read()
        else:
            if not sample["gex_fastqs"]:
                problems.append(f"{where}: gex_fastqs is empty")
            sample["has_tcr"] = bool(sample["tcr_fastqs"])
            for library in ("gex", "tcr"):
                if sample[f"{library}_fastqs"]:
                    folder, fastq_id, links = find_fastqs(
                        sample[f"{library}_fastqs"],
                        row.get(f"{library}_fastq_id", ""),
                        library, pool, where, problems,
                    )
                    sample[f"{library}_fastqs"] = folder
                    sample[f"{library}_fastq_id"] = fastq_id
                    sample["fastq_links"].update(links)

        if row.get("expect_cells"):
            try:
                sample["expect_cells"] = positive_int(row["expect_cells"], "expect_cells")
            except ValueError:
                problems.append(f"{where}: expect_cells must be a whole number")

        if sample["has_tcr"] and not VDJ_REFERENCE and not sample["multi_csv"]:
            problems.append(
                f"{where}: has TCR FASTQs but cellranger.vdj_reference is empty in config.yaml"
            )

        n_hla_donors = None
        if sample["hla_csv"]:
            try:
                table = hla_table.read_hla_table(sample["hla_csv"])
            except hla_table.HLATableError as error:
                problems.append(f"{where}: problem in the HLA table {error}")
            else:
                n_hla_donors = len(table.donors_in_pool(pool))
                if table.pools and not n_hla_donors:
                    pools_found = sorted({name for name in table.pools.values() if name})
                    problems.append(
                        f"{where}: the HLA table has a pool column but no patients of pool "
                        f"{pool} (pools in the table: {', '.join(pools_found)})"
                    )
                if not matching_genes & set(table.genes):
                    problems.append(
                        f"{where}: the HLA table has genes {', '.join(table.genes)} "
                        f"but matching uses {MATCHING_GENES} (matching.genes in config.yaml)"
                    )
                for column in table.suspicious_columns:
                    warnings.append(
                        f"{where}: HLA table column '{column}' looks like an HLA column but is "
                        "not understood (expected names like A_1, A_2 or A1, A2) and is ignored"
                    )

        if sample["manual_assignments"] and not os.path.isfile(sample["manual_assignments"]):
            problems.append(
                f"{where}: manual_assignments not found: {sample['manual_assignments']}"
            )

        n_donors = row.get("n_donors", "")
        if n_donors:
            try:
                sample["n_donors"] = int(n_donors)
            except ValueError:
                problems.append(f"{where}: n_donors must be a whole number, got {n_donors!r}")
            else:
                if sample["n_donors"] < 2:
                    problems.append(f"{where}: n_donors must be at least 2")
        elif n_hla_donors:
            sample["n_donors"] = n_hla_donors
        else:
            problems.append(
                f"{where}: n_donors is empty (fill it in, or give an hla_csv and its "
                "number of donors is used)"
            )

        if n_hla_donors and sample["n_donors"] and n_hla_donors < sample["n_donors"]:
            warnings.append(
                f"{where}: n_donors is {sample['n_donors']} but the HLA table lists "
                f"{n_hla_donors} patients; patients missing from the table keep their "
                "souporcell cluster name"
            )
        elif n_hla_donors and sample["n_donors"] and n_hla_donors > sample["n_donors"] and not table.pools:
            print(
                f"[scHLA-demux] {where}: the HLA table lists {n_hla_donors} patients for "
                f"{sample['n_donors']} in this pool (fine for a table shared between pools)",
                file=sys.stderr,
            )

        samples[pool] = sample

    return samples, problems, warnings


def check_tools(samples):
    problems = []
    needed = [
        ("cellranger.executable", CELLRANGER, os.path.isfile),
        ("cellranger.gex_reference", GEX_REFERENCE, os.path.isdir),
        ("souporcell.container", SOUPORCELL_CONTAINER, os.path.isfile),
        ("souporcell.reference_fasta", SOUPORCELL_FASTA, os.path.isfile),
        ("arcashla.env_bin (arcasHLA)", ARCASHLA_CMD, os.path.isfile),
        ("arcashla.env_bin (samtools)", SAMTOOLS_CMD, os.path.isfile),
        ("arcashla.subset_bam", SUBSET_BAM, os.path.isfile),
    ]
    if MATCHING_BY_READS:
        needed.append(("arcashla.env_bin (python)", ARCASHLA_PYTHON, os.path.isfile))
        needed.append(("arcasHLA reference (run setup.sh)", ARCASHLA_REFERENCE_JSON, os.path.isfile))
    if VDJ_REFERENCE and any(sample["has_tcr"] for sample in samples.values()):
        needed.append(("cellranger.vdj_reference", VDJ_REFERENCE, os.path.isdir))

    for label, path, exists in needed:
        if not exists(path):
            problems.append(f"config.yaml {label}: not found: {path}")
    return problems


SAMPLES, _problems, _warnings = load_samples(SAMPLES_CSV)
_problems += check_tools(SAMPLES)

for _warning in _warnings:
    print(f"[warning] {_warning}", file=sys.stderr)
if _problems:
    raise WorkflowError(
        "Please fix these problems before running scHLA-demux:\n"
        + "\n".join(f"  - {problem}" for problem in _problems)
    )

POOLS = list(SAMPLES)


# --------------------------------------------------------------------------
# Run record: what produced the results (results/run_info/<date_time>/)
# --------------------------------------------------------------------------

def command_output(command):
    import subprocess
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=120)
        return (result.stdout or result.stderr).strip().splitlines()[0]
    except Exception as error:  # a missing version must never stop the run
        return f"unknown ({error})"


def record_run_info():
    import shutil
    import time

    run_dir = os.path.join(RESULTS_ROOT, "run_info", time.strftime("%Y%m%d_%H%M%S"))
    os.makedirs(run_dir, exist_ok=True)
    inputs = [SAMPLES_CSV, *workflow.configfiles]
    for sample in SAMPLES.values():
        inputs += [sample["hla_csv"], sample["manual_assignments"], sample["multi_csv"]]
    for path in dict.fromkeys(path for path in inputs if path and os.path.isfile(path)):
        name = os.path.basename(path)
        target = os.path.join(run_dir, name)
        if os.path.exists(target):
            target = os.path.join(run_dir, f"{len(os.listdir(run_dir))}_{name}")
        shutil.copy2(path, target)

    imgt = glob.glob(os.path.join(os.path.dirname(ARCASHLA_ENV_BIN), "share", "arcas-hla-*",
                                  "dat", "IMGTHLA", "release_version.txt"))
    versions = {
        "command": " ".join(sys.argv),
        "scHLA-demux": command_output(["git", "-C", REPO_ROOT, "describe", "--always", "--dirty"]),
        "snakemake": command_output([sys.executable, "-m", "snakemake", "--version"]),
        "cellranger": command_output([CELLRANGER, "--version"]),
        "gex_reference": os.path.realpath(GEX_REFERENCE),
        "vdj_reference": os.path.realpath(VDJ_REFERENCE) if VDJ_REFERENCE else "",
        "souporcell_container": os.path.realpath(SOUPORCELL_CONTAINER),
        "arcasHLA": ", ".join(os.path.basename(path) for path in glob.glob(
            os.path.join(os.path.dirname(ARCASHLA_ENV_BIN), "share", "arcas-hla-*"))),
        "IMGT/HLA": command_output(["grep", "^# version", imgt[0]]).lstrip("# ") if imgt else "unknown",
        "kallisto": command_output([os.path.join(ARCASHLA_ENV_BIN, "kallisto"), "version"]),
        "samtools": command_output([SAMTOOLS_CMD, "--version"]),
        "subset-bam": command_output([SUBSET_BAM, "--version"]),
    }
    with open(os.path.join(run_dir, "versions.txt"), "w") as handle:
        for name, value in versions.items():
            handle.write(f"{name}: {value}\n")
    print(f"[scHLA-demux] run record: {run_dir}", file=sys.stderr)


onstart:
    record_run_info()


onsuccess:
    # HLA naming needs 5' data: say so at the end of the run, not only in the report
    for _pool in POOLS:
        _library = chemistry.gene_expression_chemistry(os.path.join(RESULTS_ROOT, _pool, "cellranger", "outs"))
        if chemistry.is_five_prime(_library) is False:
            print(f"[scHLA-demux] WARNING pool {_pool}: Cell Ranger chemistry is {_library}. "
                  f"{chemistry.THREE_PRIME_NOTE}", file=sys.stderr)

for _sample in SAMPLES.values():
    print(
        f"[scHLA-demux] pool {_sample['pool']}: "
        f"{'GEX + TCR' if _sample['has_tcr'] else 'GEX only'}, "
        f"{_sample['n_donors']} donors, "
        f"HLA table: {_sample['hla_csv'] or 'none (clusters keep souporcell names)'}",
        file=sys.stderr,
    )


wildcard_constraints:
    pool="|".join(re.escape(pool) for pool in POOLS),
    donor=r"\d+",


