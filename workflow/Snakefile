TMP_DIR = resolve_path(cfg("arcashla.tmp_dir"))
ARCAS_TEMP_DIR = resolve_path(cfg("arcashla.temp_dir"))
HLA_GENES = str(cfg("arcashla.genes"))
HLA_POPULATION = str(cfg("arcashla.population"))

REFERENCE_HLA_CSV = resolve_optional_path(
    cfg_or_default("inputs.reference_hla_csv", None)
