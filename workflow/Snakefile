FASTQ_LINKS_DONE = os.path.join(POOL_DIR, "snakemake_state", "fastq_links.done")
CELLRANGER_RUN_DIR = os.path.join(POOL_DIR, "cellranger")
CELLRANGER_DONE = os.path.join(POOL_DIR, "snakemake_state", "cellranger_multi.done")
SOUPORCELL_CLUSTERS = os.path.join(POOL_DIR, "souporcell", "clusters.tsv")

ARCASHLA_ROOT = os.path.join(POOL_DIR, "arcasHLA")
BARCODE_DIR = os.path.join(ARCASHLA_ROOT, "barcode_lists")
