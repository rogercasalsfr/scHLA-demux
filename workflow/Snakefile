    cfg_or_default("arcashla.filter_threads", ARCASHLA_DONOR_THREADS),
    "arcashla.filter_threads",
)
ARCASHLA_EXTRACT_THREADS = positive_int(
    cfg_or_default("arcashla.extract_threads", ARCASHLA_DONOR_THREADS),
    "arcashla.extract_threads",
)
ARCASHLA_GENOTYPE_THREADS = positive_int(
    cfg_or_default("arcashla.genotype_threads", ARCASHLA_DONOR_THREADS),
    "arcashla.genotype_threads",
)
ARCASHLA_ENV_BIN = resolve_path(cfg("arcashla.env_bin"))
ARCASHLA_CMD = os.path.join(ARCASHLA_ENV_BIN, "arcasHLA")
SAMTOOLS_CMD = os.path.join(ARCASHLA_ENV_BIN, "samtools")
