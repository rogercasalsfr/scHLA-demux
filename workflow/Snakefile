def cfg(path):
    value = config
    for key in path.split("."):
        if key not in value:
            raise KeyError(f"Missing config entry: {path}")
        value = value[key]
    return value


def cfg_or_default(path, default):
    value = config
    for key in path.split("."):
        if not isinstance(value, dict) or key not in value:
            return default
        value = value[key]
    return value


def positive_int(value, label):
    value = int(value)
    if value < 1:
        raise ValueError(f"{label} must be >= 1, got {value}")
    return value


def optional_positive_int(value, label):
    if value in (None, ""):
        return None
    return positive_int(value, label)


def parse_bool(value, label):
    if isinstance(value, bool):
        return value

    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in {"1", "true", "yes", "y", "on"}:
            return True
        if normalized in {"0", "false", "no", "n", "off"}:
            return False

    raise ValueError(f"{label} must be a boolean, got {value!r}")


def comma_separated(value):
    if isinstance(value, (list, tuple)):
        items = [str(item).strip() for item in value if str(item).strip()]
    else:
        items = [item.strip() for item in str(value).split(",") if item.strip()]
    return ",".join(items)


def donor_phase_threads(total_threads, parallel_jobs):
    parallel_jobs = positive_int(parallel_jobs, "parallel_jobs")
    return max(1, total_threads // parallel_jobs)


def machine_cpus():
    """CPUs of this SLURM job, or of the machine outside SLURM."""
    for variable in ("SLURM_CPUS_PER_TASK", "SLURM_CPUS_ON_NODE"):
        value = os.environ.get(variable, "")
        if value.isdigit():
            return int(value)
    return os.cpu_count() or 1


def machine_mem_gb():
    """Memory of this SLURM job, or the memory available on the machine."""
    value = os.environ.get("SLURM_MEM_PER_NODE", "")
    if value.isdigit():
        return int(value) // 1024
    with open("/proc/meminfo") as handle:
        for line in handle:
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) // (1024 * 1024)
    return 16


def is_auto(value):
    return str(value).strip().lower() in {"", "auto"}


def threads_setting(path):
    """A thread count from config.yaml; 'auto' uses every CPU of the job."""
    value = cfg(path)
    return machine_cpus() if is_auto(value) else positive_int(value, path)


def souporcell_safe_threads(fasta, threads):
    """The thread count to give souporcell, at most `threads`.

    souporcell 2.5 splits the genome into one freebayes region per thread
    (get_fasta_regions) and adds an empty region, on which freebayes fails, when a
    chromosome ends exactly on a split boundary. Use the largest thread count
    that does not do that for this genome.
    """
    fai = f"{fasta}.fai"
    if not os.path.isfile(fai):
        return threads
    with open(fai) as handle:
        lengths = {line.split("\t")[0]: int(line.split("\t")[1]) for line in handle if line.strip()}
    total = sum(lengths.values())
    for candidate in range(threads, 0, -1):
        step = math.ceil(total / candidate)
        ends, empty_region = 0, False
        for chrom in sorted(lengths):
            if lengths[chrom] < 250000:  # souporcell skips these
                continue
            ends += lengths[chrom]
            empty_region = empty_region or ends % step == 0
        if not empty_region:
            return candidate
    return threads


def resolve_path(path):
    path = os.path.expanduser(str(path))
    if os.path.isabs(path):
        return path
    return os.path.join(REPO_ROOT, path)


def resolve_optional_path(path):
    if path in (None, ""):
        return None
    return resolve_path(path)


