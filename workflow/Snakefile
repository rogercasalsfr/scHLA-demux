SOUPORCELL_COMMON_VARIANTS = resolve_optional_path(
    cfg_or_default("souporcell.common_variants", None)
)
SOUPORCELL_SKIP_REMAP = parse_bool(
    cfg_or_default("souporcell.skip_remap", False),
    "souporcell.skip_remap",
)
SOUPORCELL_MAX_LOCI = optional_positive_int(
    cfg_or_default("souporcell.max_loci", None),
    "souporcell.max_loci",
)

if SOUPORCELL_SKIP_REMAP and not SOUPORCELL_COMMON_VARIANTS:
    raise ValueError(
        "souporcell.skip_remap requires souporcell.common_variants in this workflow"
    )

if SOUPORCELL_THREADS > 24:
    print(
        f"[config warning] souporcell.threads={SOUPORCELL_THREADS}; "
        "souporcell often becomes I/O-bound above ~16-20 threads on shared "
        "filesystems because remap/retag creates many large temporary files."
    )

SOUPORCELL_OPTIONAL_ARGS = " ".join(
    arg
    for arg in [
        (
            f"--common_variants {SOUPORCELL_COMMON_VARIANTS}"
            if SOUPORCELL_COMMON_VARIANTS
            else ""
        ),
        "--skip_remap True" if SOUPORCELL_SKIP_REMAP else "",
        f"--max_loci {SOUPORCELL_MAX_LOCI}" if SOUPORCELL_MAX_LOCI else "",
    ]
    if arg
)

